# =============================================================================
# Apply — local / shared env template (placeholders only — no real secrets)
# Copy to .env.local and fill values. For Vercel, use .env.vercel.example.
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database: Neon PostgreSQL (Drizzle) ---
# Console → Project → Connection string (pooled). Prefer ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Auth: Auth.js (JWT) + Google OAuth ---
# Users are stored in Neon Postgres `users` table (independent of Neon Auth).
# 1. Google Cloud Console → APIs & Services → Credentials → Create OAuth client (Web)
# 2. Authorized redirect URIs:
#      http://localhost:3000/api/auth/callback/google
#      https://apply.neexmeet.com/api/auth/callback/google
# 3. AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32-output
AUTH_GOOGLE_ID=858157776586-75d99dquen5484thqn71o96m7ef94a65.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=paste-google-client-secret-here
AUTH_URL=http://localhost:3000

# --- AI: Gemini (preferred for resume / cover letter / mock interview) ---
# https://aistudio.google.com → Create API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- AI: Groq (fast text fallback + Whisper STT for mock interview) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- AI: ElevenLabs (mock interview TTS) ---
# https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- AI: OpenAI (text fallback + HD TTS for mock interview personas) ---
# https://platform.openai.com/api-keys
# TTS uses tts-1-hd (~$0.015 / 1k chars ≈ ₹1 per mock session)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Uploads: UploadThing ---
UPLOADTHING_TOKEN=
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# --- Billing & admin ---
ADMIN_EMAIL=you@example.com
NEXT_PUBLIC_ADMIN_EMAIL=you@example.com
PAYMENT_NOTIFY_EMAIL=you@example.com
PAYMENT_FROM_EMAIL=Apply <onboarding@resend.dev>
PAYMENT_ADMIN_SECRET=change-me-to-a-long-secret
RESEND_API_KEY=

# --- Analytics: PostHog ---
# Get your project token from: https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Analytics: Umami (optional) ---
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- SEO: Google Search Console (HTML meta tag; value is public) ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=aMaC-d-l0Bvd80mzAuNQdWqHZXgzfxpwTl0kcLpdC6I

# --- Chatbot: Apna AI widget (optional) ---
NEXT_PUBLIC_CHATBOT_SRC=https://apnaai.online/chatBot.js
NEXT_PUBLIC_CHATBOT_OWNER_ID=usr_129633093731483650

# --- Job Search APIs (Adzuna + HeroHunt) — see docs/job-apis-setup.md ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
HEROHUNT_API_KEY=
HEROHUNT_API_BASE_URL=https://api.herohunt.ai/v1/people/search

# --- Local-only overrides (optional; not needed on Vercel) ---
# RESUME_LOCAL_STORE_PATH=
# RESUME_DATA_DIR=

# --- Removed (do not set) ---
# CLERK_* — replaced by Neon Auth
# MONGODB_URI — replaced by DATABASE_URL (Neon Postgres)
# CLOUDINARY_* — unused by current app code
