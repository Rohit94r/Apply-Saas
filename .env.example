NEXT_PUBLIC_APP_URL=https://apply.neexmeet.com
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/apply

# Gemini — resume tailoring, cover letters, ATS, critique, and preferred mock interviewer
# Get a free key: https://aistudio.google.com → Create API key
# Optional for mock interview: GROQ_API_KEY alone works (Gemini improves quality when set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq — fast text AI fallback + Whisper STT for mock interview voice answers
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Whisper STT model (voice answers on /dashboard/mock-interview)
# Prefer browser Web Speech API when available; Whisper is the fallback.
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ElevenLabs — mock interview TTS (female interviewer voice)
# https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=
# Rachel (default female English). Override for another voice from your voice library.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Turbo / Flash models are lower latency for interview turns
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Optional fallback for text AI / image generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

UPLOADTHING_TOKEN=
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

CLOUDINARY_URL=
CLOUDINARY_API_SECRET=

ADMIN_EMAIL=rjdhav67@gmail.com
NEXT_PUBLIC_ADMIN_EMAIL=rjdhav67@gmail.com

PAYMENT_NOTIFY_EMAIL=you@gmail.com
PAYMENT_FROM_EMAIL=Apply <onboarding@resend.dev>
PAYMENT_ADMIN_SECRET=change-me-to-a-long-secret
RESEND_API_KEY=

NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Google Search Console (HTML meta tag verification)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=aMaC-d-l0Bvd80mzAuNQdWqHZXgzfxpwTl0kcLpdC6I

