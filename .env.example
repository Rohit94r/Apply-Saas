# =============================================================================
# Apply — local / shared env template (placeholders only — no real secrets)
# Copy to .env.local and fill values. For Vercel, use .env.vercel.example.
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database: Neon PostgreSQL (Drizzle) ---
# Console → Project → Connection string (pooled). Prefer ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Auth: Neon Auth (Managed Better Auth) ---
# Exact Console steps:
#   1. https://console.neon.tech → your project → Branch (usually production)
#   2. Auth → Enable Auth (one-time; creates neon_auth schema)
#   3. Configuration → copy Auth URL into NEON_AUTH_BASE_URL
#   4. Trusted domains → add http://localhost:3000 and your production origin
# Auth URL format (must contain .neonauth. and end with /auth):
#   https://ep-<endpoint-id>.neonauth.[c-N.]<region>.aws.neon.tech/<database>/auth
# Example (include c-N cell id when present on your DB/Data API host):
#   https://ep-curly-voice-ahtglisi.neonauth.c-3.us-east-1.aws.neon.tech/neondb/auth
# DO NOT use the Neon Data API / REST URL for NEON_AUTH_BASE_URL.
# That looks like: https://ep-xxx.apirest.c-N.<region>.aws.neon.tech/<db>/rest/v1
# (apirest + /rest/v1 = PostgREST Data API; this app uses DATABASE_URL via Drizzle instead.)
# Only NEON_AUTH_BASE_URL + NEON_AUTH_COOKIE_SECRET are required by @neondatabase/auth.
# Cookie secret: openssl rand -base64 32  (must be 32+ characters)
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.c-3.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-openssl-rand-base64-32-output

# --- AI: Gemini (preferred for resume / cover letter / mock interview) ---
# https://aistudio.google.com → Create API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- AI: Groq (fast text fallback + Whisper STT for mock interview) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- AI: ElevenLabs (mock interview TTS) ---
# https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- AI: OpenAI (optional fallback) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Uploads: UploadThing ---
UPLOADTHING_TOKEN=
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# --- Billing & admin ---
