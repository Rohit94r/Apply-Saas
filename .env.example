NEXT_PUBLIC_ADMIN_EMAIL=you@example.com
PAYMENT_NOTIFY_EMAIL=you@example.com
PAYMENT_FROM_EMAIL=Apply <onboarding@resend.dev>
PAYMENT_ADMIN_SECRET=change-me-to-a-long-secret
RESEND_API_KEY=

# --- Analytics: Umami (optional) ---
