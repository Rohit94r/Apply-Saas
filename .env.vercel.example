# =============================================================================
# Apply — Vercel Environment Variables TEMPLATE (committed — placeholders only)
# Real secrets live in gitignored `.env.vercel` (synced from `.env.local`).
# Vercel → Project → Settings → Environment Variables → paste from `.env.vercel`
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=https://apply.neexmeet.com

# --- Database: Neon PostgreSQL (Drizzle) ---
# Paste the real Neon pooled connection string in the Vercel dashboard only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Auth: Auth.js (JWT) + Google OAuth ---
# DO NOT paste "replace-with-…" into Vercel — that is a placeholder.
# Copy REAL values from your local .env.local / .env.vercel (gitignored).
# Redirect: https://apply.neexmeet.com/api/auth/callback/google
AUTH_SECRET=replace-with-openssl-rand-hex-32-output
NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32-output
AUTH_GOOGLE_ID=858157776586-75d99dquen5484thqn71o96m7ef94a65.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=paste-google-client-secret-here
AUTH_URL=https://apply.neexmeet.com

# --- AI: Gemini (preferred) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

