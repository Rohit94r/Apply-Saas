# Apply production environment variables for Vercel.
# Add these in Vercel Dashboard -> Project -> Settings -> Environment Variables.
# Do not commit real secret values.

# App
NEXT_PUBLIC_APP_URL=https://apply.neexmeet.com

# Database — Neon PostgreSQL (Drizzle)
# Paste the real connection string only in Vercel env vars, never in git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# AI
GROQ_API_KEY=gsk_your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: only needed for OpenAI fallback
OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Auth: Neon Auth (Managed Better Auth)
# Console: Neon Project → Branch → Auth → Enable Auth → Configuration → Auth URL
# Cookie secret: openssl rand -base64 32
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-openssl-rand-base64-32-output

# Upload storage: UploadThing
UPLOADTHING_TOKEN=your-uploadthing-token
UPLOADTHING_SECRET=sk_live_your-uploadthing-secret
UPLOADTHING_APP_ID=your-uploadthing-app-id

# Optional: Cloudinary, if you prefer it for media storage
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_API_SECRET=<api_secret>

# Analytics: Umami
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id

# Google Search Console (HTML meta tag verification)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=aMaC-d-l0Bvd80mzAuNQdWqHZXgzfxpwTl0kcLpdC6I

# Apna AI chatbot widget
NEXT_PUBLIC_CHATBOT_SRC=https://apnaai.online/chatBot.js
NEXT_PUBLIC_CHATBOT_OWNER_ID=usr_129633093731483650

# Billing & admin (must match your GitHub / Vercel login email)
ADMIN_EMAIL=rjdhav67@gmail.com
NEXT_PUBLIC_ADMIN_EMAIL=rjdhav67@gmail.com
PAYMENT_NOTIFY_EMAIL=rjdhav67@gmail.com
PAYMENT_FROM_EMAIL=Apply <onboarding@resend.dev>
PAYMENT_ADMIN_SECRET=use-a-long-random-secret
RESEND_API_KEY=re_your_resend_key

# Job APIs — Adzuna + HeroHunt (see docs/job-apis-setup.md)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
HEROHUNT_API_KEY=
HEROHUNT_API_BASE_URL=https://api.herohunt.ai/v1/people/search
