# =============================================================================
# Apply — Vercel Environment Variables (copy-paste ready)
# Vercel → Project → Settings → Environment Variables
# Add for Production + Preview. Do NOT commit real secrets.
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=https://apply.neexmeet.com

# --- Database: Neon PostgreSQL (Drizzle) ---
# Paste the real Neon pooled connection string in the Vercel dashboard only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Auth: Neon Auth (Managed Better Auth) ---
# Neon Console → Project → Branch → Auth → Enable Auth → Configuration → Auth URL
# Cookie secret: openssl rand -base64 32
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-openssl-rand-base64-32-output

# --- AI: Gemini (preferred) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- AI: Groq (text fallback + Whisper STT) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- AI: ElevenLabs (mock interview TTS) ---
ELEVENLABS_API_KEY=
